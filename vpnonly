#!/bin/bash
# vpnonly — one command for the whole thing.
#
#   vpnonly              pick an app, see what's true of it, turn it on or off
#
# Everything it does is up.sh, run.sh, status.sh and down.sh underneath; this is
# just a front end so you don't have to remember which is which.
set -uo pipefail

# Resolve through symlinks so this works when installed on PATH (Homebrew links
# bin/vpnonly to libexec via two relative hops, and $0 points at the first).
SELF="$0"
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *)  SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"
SELF="$DIR/$(basename "$SELF")"
# sudo resets PATH, so re-exec by absolute path. "$0" would be a bare
# "vpnonly" when run from PATH, and sudo would not find it.
[ "$(id -u)" = 0 ] || exec sudo -- "$SELF" "$@"
RUSER="${SUDO_USER:?run from your normal account, not as root}"
RHOME=$(dscl . -read "/Users/$RUSER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
CONF="${RHOME:-$HOME}/.config/vpnonly"

MYIP=""; VPNIP=""; SCREEN="list"; NOTE=""; ROWS=24

cannot_route() {
    case "$(basename "$1")" in
        Safari.app|"Safari Technology Preview.app") return 0 ;;
        *) return 1 ;;
    esac
}

list_apps() {
    for d in /Applications "$RHOME/Applications" /Applications/Utilities; do
        [ -d "$d" ] || continue
        for app in "$d"/*.app; do
            [ -d "$app" ] || continue
            cannot_route "$app" && continue
            printf '%s\n' "$app"
        done
    done | sort -f -t/ -k99
}

tunnel_if() { cat "$CONF/tunnel-if" 2>/dev/null || true; }

tunnel_up() {
    local i; i=$(tunnel_if)
    [ -n "$i" ] && ifconfig "$i" >/dev/null 2>&1
}

vpn_gid() { dscl . -read /Groups/vpnonly PrimaryGroupID 2>/dev/null | awk '{print $2}'; }

routed_apps() {
    local g; g=$(vpn_gid); [ -n "$g" ] || return 0
    ps -axo rgid=,comm= 2>/dev/null | awk -v g="$g" '$1 == g {
        sub(/^[0-9]+[ \t]+/, "")
        if (match($0, /\.app\//)) print substr($0, 1, RSTART + 3)
    }' | sort -u
}

pids_for_app() {
    local g app; g=$(vpn_gid); app="$1"; [ -n "$g" ] || return 0
    ps -axo pid=,rgid=,comm= 2>/dev/null | awk -v g="$g" -v a="$app/Contents/MacOS/" \
        '$2 == g && index($0, a) { print $1 }'
}

is_on() {
    local r
    for r in ${ROUTED[@]+"${ROUTED[@]}"}; do [ "$r" = "$1" ] && return 0; done
    return 1
}

refresh_ips() {
    MYIP=$(curl -s --max-time 6 https://api.ipify.org 2>/dev/null || echo "?")
    if tunnel_up; then
        VPNIP=$("$DIR/vpnrun" "$RUSER" /usr/bin/curl -s --max-time 8 https://api.ipify.org 2>/dev/null || echo "?")
    else
        VPNIP=""
    fi
}

reload_state() {
    ROUTED=()
    IFS=$'\n' read -r -d '' -a ROUTED < <(routed_apps && printf '\0') || true
}

enter_screen() { printf '\e[?1049h\e[?25l'; }
restore()      { printf '\e[?25h\e[?1049l'; }

# Leave the alternate screen so a command's own output is visible, then come
# back to a clean frame.
run_visible() {
    local rc
    restore
    echo
    "$@"
    rc=$?
    echo
    printf 'press enter to continue '
    read -r _ </dev/tty
    enter_screen
    return $rc
}

banner() {
    # Only when there's room. On a short window the app list matters more.
    [ "$ROWS" -ge 26 ] || { printf '  \e[1;36mVPNonly\e[0m\n\n'; return; }
    printf '  \e[36m%s\e[0m\n' \
        '▗▖  ▗▖▗▄▄▖ ▗▖  ▗▖ ▗▄▖ ▗▖  ▗▖▗▖ ▗▖  ▗▖' \
        '▐▌  ▐▌▐▌ ▐▌▐▛▚▖▐▌▐▌ ▐▌▐▛▚▖▐▌▐▌  ▝▚▞▘ ' \
        '▐▌  ▐▌▐▛▀▘ ▐▌ ▝▜▌▐▌ ▐▌▐▌ ▝▜▌▐▌   ▐▌  ' \
        ' ▝▚▞▘ ▐▌   ▐▌  ▐▌▝▚▄▞▘▐▌  ▐▌▐▙▄▄▖▐▌  '
    printf '\n  \e[2mone app on the VPN, not your whole Mac\e[0m\n\n'
}

connection_line() {
    if tunnel_up; then
        printf '  \e[32m●\e[0m connected\e[2m ·\e[0m %s' "$(tunnel_if)"
        [ -n "$VPNIP" ] && [ "$VPNIP" != "?" ] &&
            printf '\e[2m ·\e[0m exit \e[32m%s\e[0m' "$VPNIP"
        printf '\n'
    else
        printf '  \e[2m○ not connected\e[0m'
        if [ "${#ROUTED[@]}" -gt 0 ]; then
            # Tagged apps with no tunnel are refused, not leaking. Say that,
            # rather than calling them protected.
            printf '\e[2m ·\e[0m \e[33m%d app%s blocked by the kill switch\e[0m' \
                "${#ROUTED[@]}" "$([ "${#ROUTED[@]}" -eq 1 ] || echo s)"
        fi
        printf '\n'
    fi
}

draw_list() {
    local view i name state
    if [ "$ROWS" -ge 26 ]; then view=$((ROWS - 13)); else view=$((ROWS - 8)); fi
    [ "$view" -lt 3 ] && view=3
    [ "${#APPS[@]}" -lt "$view" ] && view=${#APPS[@]}
    [ "$SEL" -lt "$TOP" ] && TOP=$SEL
    [ "$SEL" -ge $((TOP + view)) ] && TOP=$((SEL - view + 1))

    banner
    connection_line
    printf '  \e[2myour address is %s\e[0m\n\n' "${MYIP:-?}"

    i=$TOP
    while [ "$i" -lt $((TOP + view)) ] && [ "$i" -lt "${#APPS[@]}" ]; do
        name=$(basename "${APPS[$i]}" .app)
        state=""
        if is_on "${APPS[$i]}"; then
            if tunnel_up; then state=$'\e[32m● in VPN\e[0m'
            else state=$'\e[33m● blocked\e[0m'; fi
        fi
        if [ "$i" -eq "$SEL" ]; then
            printf '\e[36m▶\e[0m \e[1m%-30s\e[0m %b\n' "$name" "$state"
        else
            printf '  %-30s %b\n' "$name" "$state"
        fi
        i=$((i + 1))
    done

    printf '\n  \e[2m↑↓  |  Enter\e[0m open  \e[2m|  D\e[0m disconnect  \e[2m|  R\e[0m refresh  \e[2m|  Q\e[0m quit'
}

draw_app() {
    local app name
    app="${APPS[$SEL]}"; name=$(basename "$app" .app)

    printf '  \e[1;36m%s\e[0m\n\n' "$name"

    if is_on "$app"; then
        if tunnel_up; then
            printf '  in the VPN      \e[32myes\e[0m\e[2m, through %s\e[0m\n' "$(tunnel_if)"
            printf '  its address     \e[32m%s\e[0m\n' "${VPNIP:-checking…}"
        else
            printf '  in the VPN      \e[33mheld offline\e[0m\n'
            printf '  \e[2m                the tunnel is down, so it is refused rather\n'
            printf '                  than quietly using your normal connection\e[0m\n'
        fi
    else
        printf '  in the VPN      \e[2mno\e[0m\n'
        printf '  its address     \e[2m%s, same as the rest of your Mac\e[0m\n' "${MYIP:-?}"
    fi
    printf '  your address    %s\n\n' "${MYIP:-?}"

    if is_on "$app"; then
        printf '  \e[36m▶\e[0m \e[1mTurn off\e[0m\n'
        printf '    \e[2mQuits %s and reopens it on your normal connection.\e[0m\n' "$name"
    else
        printf '  \e[36m▶\e[0m \e[1mTurn on\e[0m\n'
        if tunnel_up; then
            printf '    \e[2mReopens %s inside the tunnel. Nothing else moves.\e[0m\n' "$name"
        else
            printf '    \e[2mConnects the tunnel, then reopens %s inside it.\e[0m\n' "$name"
        fi
    fi

    [ -n "$NOTE" ] && printf '\n  \e[33m%s\e[0m\n' "$NOTE"
    printf '\n  \e[2mEnter\e[0m do it  \e[2m|  Esc\e[0m back  \e[2m|  Q\e[0m quit'
}

turn_on() {
    local app="$1"
    tunnel_up || run_visible "$DIR/up.sh" || return 1
    run_visible "$DIR/run.sh" "$app"
}

turn_off() {
    local app="$1" name; name=$(basename "$app" .app)
    restore
    echo
    echo "Quitting $name so it can rejoin your normal connection…"
    osascript -e "quit app \"$name\"" 2>/dev/null || true
    for _ in $(seq 1 40); do
        [ -z "$(pids_for_app "$app")" ] && break
        sleep 0.25
    done
    if [ -n "$(pids_for_app "$app")" ]; then
        echo "$name didn't quit. Close it yourself, then press enter."
    else
        sudo -u "$RUSER" open -a "$app" 2>/dev/null &&
            echo "$name reopened on your normal connection." ||
            echo "$name is closed. Open it when you want it back."
    fi
    echo
    printf 'press enter to continue '
    read -r _ </dev/tty
    enter_screen
}

IFS=$'\n' read -r -d '' -a APPS < <(list_apps && printf '\0') || true
[ "${#APPS[@]}" -gt 0 ] || { echo "no apps found in /Applications"; exit 1; }
ROUTED=(); SEL=0; TOP=0

trap 'restore; exit 130' INT
enter_screen
reload_state
refresh_ips

while :; do
    ROWS=$(tput lines 2>/dev/null || echo 24)
    printf '\e[H\e[2J\e[3J'
    if [ "$SCREEN" = "list" ]; then draw_list; else draw_app; fi

    IFS= read -rsn1 key </dev/tty || { restore; exit 1; }

    if [ "$SCREEN" = "app" ]; then
        # No arrows on this screen, so a bare Esc means back and needs no
        # follow-up read — which bash 3.2 cannot do without a timeout.
        case "$key" in
            $'\e') SCREEN="list"; NOTE="" ;;
            q|Q)   restore; exit 0 ;;
            "")
                app="${APPS[$SEL]}"; NOTE=""
                if is_on "$app"; then
                    turn_off "$app"
                else
                    turn_on "$app" || NOTE="That didn't finish. The message above says why."
                fi
                reload_state; refresh_ips
                [ -z "$NOTE" ] && SCREEN="list"
                ;;
        esac
        continue
    fi

    case "$key" in
        $'\e')
            # bash 3.2 rejects a fractional read timeout, so read the two bytes
            # after ESC unconditionally. An arrow always sends all three.
            IFS= read -rsn2 rest </dev/tty || rest=""
            case "$rest" in
                '[A') [ "$SEL" -gt 0 ] && SEL=$((SEL - 1)) ;;
                '[B') [ "$SEL" -lt $((${#APPS[@]} - 1)) ] && SEL=$((SEL + 1)) ;;
            esac ;;
        k) [ "$SEL" -gt 0 ] && SEL=$((SEL - 1)) ;;
        j) [ "$SEL" -lt $((${#APPS[@]} - 1)) ] && SEL=$((SEL + 1)) ;;
        "") SCREEN="app"; NOTE="" ;;
        d|D) run_visible "$DIR/down.sh"; reload_state; refresh_ips ;;
        r|R) reload_state; refresh_ips ;;
        q|Q) restore; exit 0 ;;
    esac
done
